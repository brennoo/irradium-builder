# Description: SDL, Simple DirectMedia Layer
# URL: https://www.libsdl.org/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: alsa-lib glu

name=libsdl
version=1.2.15
release=6
source=(https://www.libsdl.org/release/SDL-$version.tar.gz
  $name-1.2.x-libx11.patch $name-$version-bs.patch
  CVE-2019-13616.patch
  CVE-2019-7572.patch
  CVE-2019-7635.patch
  CVE-2019-7636.patch
  CVE-2019-7637.patch
  CVE-2022-34568.patch)

build() {
  cd SDL-$version

  patch -p1 -i $SRC/$name-1.2.x-libx11.patch
  patch -p1 -i $SRC/$name-$version-bs.patch

  for p in $SRC/CVE-*.patch; do
    patch -p1 -i "$p"
  done

  ./configure \
    --prefix=/usr \
    --enable-alsa \
    --disable-rpath \
    --build=$(uname -m)-unknown-linux-gnu

  make
  make DESTDIR=$PKG install
}
